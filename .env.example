# ---- Core ----
# Public HTTPS URL of the app (widget URLs + Auth.js origin)
APP_URL=https://nowave.example.com
AUTH_URL=https://nowave.example.com
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-an-independent-base64-secret
# Generate independently: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-different-base64-key

# ---- Database ----
DATABASE_URL=postgresql://nowave:nowave@localhost:5432/nowave
# Used by docker-compose for the postgres container
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# ---- Dashboard login ----
# Single-tenant: this password gates the dashboard (no OAuth).
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
# Optional: owner account email (cosmetic, used as the internal user key)
# OWNER_EMAIL=owner@razexlabs.local

# ---- Spotify now-playing source ----
# No developer app / Premium needed. The user pastes their open.spotify.com
# `sp_dc` cookie in the dashboard; the server mints web-player tokens from it.
# Spotify guards the token endpoint with a TOTP. A working secret is built in;
# override here if Spotify rotates it (comma-separated cipher bytes + version):
# SPOTIFY_TOTP_SECRET=44,55,47,...
# SPOTIFY_TOTP_VER=61

# ---- Spotify Canvas (optional) ----
# Unofficial canvaz endpoint; set to false to disable canvas video fetching.
CANVAS_ENABLED=true
