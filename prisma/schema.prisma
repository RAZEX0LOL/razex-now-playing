generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js (NextAuth) standard models ----
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  connections   Connection[]
  widgets       Widget[]
  createdAt     DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- App models ----

/// A linked music source (Spotify OAuth, or YouTube Music via companion ingest key)
model Connection {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       Provider
  providerUserId String?
  displayName    String?
  // Spotify: AES-256-GCM encrypted `sp_dc` cookie (used to mint short-lived tokens)
  spDc           String?  @db.Text
  // (legacy Spotify OAuth fields, unused)
  accessToken    String?  @db.Text
  refreshToken   String?  @db.Text
  expiresAt      DateTime?
  // YouTube Music companion ingest secret (companion app POSTs now-playing with this)
  ingestKey      String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, provider])
}

enum Provider {
  spotify
  ytmusic
}

/// A configurable overlay; its public `token` is the browser-source URL slug.
model Widget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  name      String   @default("My Widget")
  source    Provider @default(spotify)
  style     String   @default("classic") // classic | minimal | vinyl
  settings  Json     @default("{}")       // { hideOnPause, onlyOnSongSwitch, accent, showCanvas, position }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
